# AdaptLearn environment template.
# Copy to `.env` (gitignored) and fill in real values.
# Used by both native dev (backend/config.py reads this via _REPO_ROOT) and
# docker compose prod stack (docker-compose.prod.yml --env-file .env).

# --- LLM provider (Google AI Studio via LiteLLM) ---
GEMINI_API_KEY=your-google-ai-studio-key-here
MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# --- Storage ---
DATABASE_URL=sqlite:///./data/app.db
UPLOADS_PATH=./data/uploads

# --- ChromaDB (vector store) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Rate limit ---
# Max chat requests per user per UTC day. Set DAILY_CAP=2 to demo the cap UI.
DAILY_CAP=50

# --- CORS ---
# Comma-separated list of allowed origins. Add your ngrok URL here when tunneling.
# Example: CORS_ORIGINS=http://localhost:5173,https://abc-123.ngrok-free.app
CORS_ORIGINS=http://localhost:5173

# --- Dev only ---
# LLM_STUB=1 short-circuits the agent loop with a canned response (CI / offline).
LLM_STUB=0
