# Crux environment template.
# Copy to `.env` (gitignored) and fill in real values.
# Used by both native dev (backend/config.py reads this via _REPO_ROOT) and
# docker compose prod stack (docker-compose.prod.yml --env-file .env).

# --- LLM provider (Google AI Studio via LiteLLM) ---
GEMINI_API_KEY=your-google-ai-studio-key-here
MODEL=gemini/gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-2

# --- Storage (Supabase-managed Postgres + pgvector — Phase 7) ---
# DATABASE_URL: from Supabase → Project Settings → Database → Connection
# string → URI (pooler, transaction mode, port 6543). The app prepends
# `postgresql+psycopg://` if you paste a bare `postgresql://` URL.
# See docs/db/postgres-pgvector-setup.md.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
UPLOADS_PATH=./data/uploads
# Uploaded-blob storage: "local" (default, dev) or "r2" (prod)
UPLOADS_STORE=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Vector dim for chunk_embeddings. Default 768 matches Gemini text-embedding-004.
# Change requires re-running migration 0002 + re-embedding all chunks.
EMBEDDING_DIM=768

# --- Supabase Auth (Phase 7) ---
# See docs/auth/supabase-setup.md. Backend verifies JWTs against JWKS.
# Uses the 2025+ key-naming model: `publishable` (frontend) + `secret` (backend).
# Legacy `anon` + `service_role` keys are NOT used.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<...backend only, never ship to client>
# Publishable key is public by design; docker compose bakes it (plus
# SUPABASE_URL) into the frontend bundle as VITE_* vars at build time.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...safe for the client bundle>

# --- LLM cost cap (Phase 7) ---
LLM_SOFT_CAP_USD=2.00
LLM_HARD_CAP_USD=3.00

# --- Rate limit ---
# Max chat requests per user per UTC day. Set DAILY_CAP=2 to demo the cap UI.
DAILY_CAP=50

# --- CORS ---
# Comma-separated list of allowed origins. Add your ngrok URL here when tunneling.
# Example: CORS_ORIGINS=http://localhost:5173,https://abc-123.ngrok-free.app
CORS_ORIGINS=http://localhost:5173

# --- Dev only ---
# LLM_STUB=1 short-circuits the agent loop with a canned response (CI / offline).
LLM_STUB=0
