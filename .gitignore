# Secrets
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
# .env.example files DO get committed (they're templates with no secrets).
!**/.env.example
# Speculative — block common credential/cert file types (F4.2, SECURITY_REVIEW L-2).
*.key
*.pem
*.crt
service-account*.json
firebase-*.json
.claude/

reports/

# Node / Vue / Vite
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.log
.eslintcache
*.timestamp-*-*.mjs

# Python / Backend
__pycache__/
*.pyc
*.pyo
*.egg-info/
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/uv.lock

# Data volumes (never commit SQLite, uploads, or ChromaDB).
# Both `data/` at repo root and `backend/data/` matter: when uvicorn is
# launched from `backend/`, UPLOADS_PATH / sqlite default to cwd-relative
# `./data` which lands under `backend/`.
data/*.db
data/uploads/
data/chroma/
backend/data/

# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
frontend/.auth/

# Orphaned old scaffold dir (node_modules lock prevents deletion while VS Code is open)
adaptlearn/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Phase 0 spike — ignore raw turn files; transcripts and decision.md are committed
spike/outputs/**/*_turn1.md
spike/outputs/**/*_turn8.md
spike/.env

CLAUDE.md