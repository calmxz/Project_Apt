# Frontend env. Copy to .env.local and fill in values.
# Used by the native dev server (npm run dev). The docker compose path bakes
# these at image build time from the root .env instead (see docker-compose.yml
# frontend build args).
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...safe for the client bundle>
