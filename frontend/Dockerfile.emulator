# Firebase Emulator Suite + Python 3.12 functions runtime.
# Base: python:3.12-slim-bookworm so `python3.12` matches firebase.json runtime: "python312".
# Installs: Node 22 (NodeSource), JRE 17 (Firestore + Storage emulators), firebase-tools.
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    NODE_MAJOR=22 \
    FIREBASE_TOOLS_VERSION=14.0.0

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        openjdk-17-jre-headless \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g firebase-tools@${FIREBASE_TOOLS_VERSION}

WORKDIR /workspace

EXPOSE 4000 4400 4500 5000 5001 8080 9099 9199

# CMD provided by docker-compose.
